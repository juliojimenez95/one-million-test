# ============================================
# One Million Test - Environment Variables
# ============================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env

# ── Database ──────────────────────────────────
# Local development (host machine → Docker Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE_NAME?schema=public"

# ── Authentication ────────────────────────────
# Secret key for signing JWT tokens (use a strong random string in production)
JWT_SECRET="change-me-to-a-strong-random-secret"

# ── OpenAI (AI-powered lead scoring) ──────────
# Get your key at https://platform.openai.com/api-keys
# Use "mock_key" to run with simulated AI responses
OPENAI_API_KEY="sk-your-openai-api-key-here"
